      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker exec wordpress wp plugin list"
      }
    }
  },
  "tags": ["type:plugin", "scope:wordpress"],
  "implicitDependencies": []
}
