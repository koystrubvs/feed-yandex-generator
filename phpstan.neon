parameters:
    level: 8
    paths:
        - includes/
        - admin/
    excludePaths:
        - tests/
        - vendor/
    bootstrapFiles:
        - tests/bootstrap-phpstan.php
    checkBenevolentUnionTypes: true
    checkDynamicProperties: true
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#Undefined variable#'
        - '#Function .* not found#'
        - '#Constant .* not found#'
        - '#Access to property#'
        - '#Access to an undefined property#'
        - '#invalid type#'
        - '#unknown class#'
        - '#is unused#'
        - '#Parameter .* expects#'
        - '#has parameter#'
        - '#return type#'
        - '#never returns#'
        - '#PHPDoc tag#'
        - '#Cannot call method#'
        - '#Call to an undefined method#'
        - '#should return#'
        - '#Variable .* might not be defined#'
        - '#always exists and is not#'
        - '#Offset .* does not exist#'
        - '#always evaluate to false#'
        - '#Negated boolean#'
        - '#Property .* has no type specified#'
        - '#Property .* is never read#'
        - '#Instantiated class .* not found#'
    reportUnmatchedIgnoredErrors: false
